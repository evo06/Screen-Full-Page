{
  "manifest_version": 3,
  "name": "ScreenSnap — Captura de Tela & Página Inteira",
  "version": "1.0.0",
  "description": "Capture uma área selecionada, a parte visível ou a página inteira com editor leve de anotações e exportação para PNG, JPEG, PDF e área de transferência.",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ScreenSnap — Capturar Tela",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "capture-visible": {
      "suggested_key": {
        "default": "Alt+Shift+1",
        "mac": "Command+Shift+1"
      },
      "description": "Capturar parte visível da página"
    },
    "capture-selection": {
      "suggested_key": {
        "default": "Alt+Shift+2",
        "mac": "Command+Shift+2"
      },
      "description": "Capturar área selecionada"
    },
    "capture-fullpage": {
      "suggested_key": {
        "default": "Alt+Shift+3",
        "mac": "Command+Shift+3"
      },
      "description": "Capturar página inteira"
    }
  }
}
